{
    // ========================================
    // VSCode Debug Configurations
    // ========================================
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: Debug Current File",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++: Compile Current File",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false
            }
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "/opt/ros/melodic/lib/python2.7/dist-packages:/opt/ros/noetic/lib/python3/dist-packages"
            }
        },
        {
            "name": "Python: Web Control UI",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/web_control_ui.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [],
            "env": {
                "PYTHONPATH": "/opt/ros/melodic/lib/python2.7/dist-packages:/opt/ros/noetic/lib/python3/dist-packages",
                "ROS_MASTER_URI": "http://localhost:11311",
                "ROS_IP": "localhost"
            }
        },
        {
            "name": "Python: Robot Control UI (PyQt5)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/robot_control_ui.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [],
            "env": {
                "PYTHONPATH": "/opt/ros/melodic/lib/python2.7/dist-packages:/opt/ros/noetic/lib/python3/dist-packages",
                "ROS_MASTER_URI": "http://localhost:11311",
                "ROS_IP": "localhost",
                "QT_QPA_PLATFORM": "xcb"
            }
        },
        {
            "name": "C++: WoorobotSDK Example",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/WoorobotSDK/build/woorobot_example",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/WoorobotSDK",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "ROS: Attach to roscore",
            "type": "python",
            "request": "attach",
            "port": 5678,
            "host": "localhost",
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ]
        }
    ]
}
