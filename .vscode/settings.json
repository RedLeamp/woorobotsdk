{
    // ========================================
    // Visual Studio Code Settings for WoorobotSDK
    // Linux + ROS + C++ Development
    // ========================================

    // ===== C/C++ Configuration =====
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-arm64",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/WoorobotSDK/include",
        "${workspaceFolder}/WoorobotSDK/woorobot_sdk_cpp",
        "/usr/include/**",
        "/usr/local/include/**",
        "/opt/ros/melodic/include/**",
        "/opt/ros/noetic/include/**"
    ],
    "C_Cpp.default.defines": [],
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}/**",
        "/usr/include",
        "/usr/local/include",
        "/opt/ros/melodic/include",
        "/opt/ros/noetic/include"
    ],
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_fallbackStyle": "Google",

    // ===== Python Configuration =====
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": true,
    "python.linting.mypyEnabled": false,
    "python.formatting.provider": "autopep8",
    "python.formatting.autopep8Args": [
        "--max-line-length=120"
    ],
    "python.autoComplete.extraPaths": [
        "/opt/ros/melodic/lib/python2.7/dist-packages",
        "/opt/ros/noetic/lib/python3/dist-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/melodic/lib/python2.7/dist-packages",
        "/opt/ros/noetic/lib/python3/dist-packages"
    ],

    // ===== ROS Configuration =====
    "ros.distro": "melodic",  // Change to "noetic" for ROS Noetic
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.sourceDirectory": "${workspaceFolder}",

    // ===== Editor Settings =====
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": false,
    "editor.rulers": [80, 120],
    "editor.wordWrap": "off",
    "editor.minimap.enabled": true,
    "editor.suggestSelection": "first",
    "editor.bracketPairColorization.enabled": true,

    // ===== File Associations =====
    "files.associations": {
        "*.launch": "xml",
        "*.xacro": "xml",
        "*.urdf": "xml",
        "*.sdf": "xml",
        "*.world": "xml",
        "*.msg": "plaintext",
        "*.srv": "plaintext",
        "*.action": "plaintext",
        "CMakeLists.txt": "cmake",
        "*.cmake": "cmake",
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "*.c": "c"
    },

    // ===== File Exclusions =====
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/build": true,
        "**/devel": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.vscode/.ropeproject": true
    },

    "search.exclude": {
        "**/build": true,
        "**/devel": true,
        "**/install": true,
        "**/log": true,
        "**/.vscode": true
    },

    // ===== Terminal Settings =====
    "terminal.integrated.shell.linux": "/bin/bash",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.env.linux": {
        "ROS_PACKAGE_PATH": "/opt/ros/melodic/share",
        "CMAKE_PREFIX_PATH": "/opt/ros/melodic"
    },

    // ===== Git Settings =====
    "git.enabled": true,
    "git.autofetch": true,
    "git.confirmSync": false,

    // ===== IntelliSense Settings =====
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

    // ===== Code Runner (Optional) =====
    "code-runner.executorMap": {
        "python": "cd $dir && python3 $fileName",
        "cpp": "cd $dir && g++ -std=c++17 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
        "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt"
    },
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,

    // ===== Markdown Settings =====
    "markdown.preview.fontSize": 14,
    "markdown.preview.lineHeight": 1.6,

    // ===== Workspace Trust =====
    "security.workspace.trust.untrustedFiles": "open"
}
